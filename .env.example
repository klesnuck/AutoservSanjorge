# -----------------------------------------------------------------------------
# Variables de entorno de Docker Compose para AutoservSanJorge
# Copia este archivo a .env (que está ignorado por git) y completa los valores reales:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# Etiqueta/versión de la imagen usada por ambas imágenes.
IMAGE_TAG=1.0.0

# Puerto del host para el frontend (http://localhost:8080).
FRONTEND_PORT=8080

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Token largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cadena-larga-y-aleatoria

# -----------------------------------------------------------------------------
# Supabase / PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=
SUPABASE_DB_URL=
DB_SSL=true

# Opcional: solo se necesita si el código usa el SDK de Supabase directamente.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
