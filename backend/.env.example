# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS SUPABASE / POSTGRESQL - AUTOSERVICIO SAN JORGE
# -----------------------------------------------------------------------------

# Puerto del servidor backend Express (por defecto: 4000)
PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# OPCIÓN A: Cadena de conexión directa de Supabase (Recomendado)
# Puedes obtenerla en Supabase -> Project Settings -> Database -> Connection String (URI / Pooler)
# Ejemplo: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=
SUPABASE_DB_URL=

# Activar SSL (Requerido para Supabase y bases de datos PostgreSQL en la nube)
DB_SSL=true

# -----------------------------------------------------------------------------
# OPCIÓN B: Conexión mediante parámetros individuales de PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=user1_abd
DB_PASSWORD=123
DB_NAME=SanJorge
DB_PORT=5432

# -----------------------------------------------------------------------------
# CLIENTE SUPABASE SDK (OPCIONAL)
# Puedes obtenerlas en Supabase -> Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
