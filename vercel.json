{
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "taller-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
